KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# Only used to create the first user when data/users.json does not exist yet.
# Whoever controls this mailbox can log in as this user.
KITE_USER_ID=
KITE_USER_EMAIL=

# Key that encrypts Kite API secrets and access tokens at rest. Keep it here,
# not in data/ next to the encrypted files. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes existing data/users.json unreadable.
USER_CONFIG_ENCRYPTION_KEY=

# Use a unique, long random value; keep stable across restarts.
SESSION_SECRET=generate_with_openssl_rand_hex_32

# Development only: when SMTP fails, return the OTP only to localhost.
# Both values must be set; keep disabled outside local development.
APP_ENV=production
OTP_DEV_FALLBACK_ENABLED=false

MAX_DAILY_LOSS=10000
MAX_POSITION_SIZE=100
MAX_EXPOSURE=500000
DEFAULT_STOP_LOSS_PCT=2.0
KILL_SWITCH_LOSS=25000

RATE_LIMIT_DEFAULT=8
RATE_LIMIT_QUOTE=1
RATE_LIMIT_HISTORICAL=3
RATE_LIMIT_ORDERS=8
MAX_RETRIES=3
RETRY_DELAY=1.0

LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
TRADE_JOURNAL_FILE=logs/trade_journal.json
BACKTEST_DATA_DIR=data/historical
INSTRUMENTS_CACHE_FILE=data/instruments.csv

# ⚠️ DEVELOPMENT ONLY - Never enable in production
DISABLE_SSL_VERIFY=false

# SMTP Configuration (OTP is sent to the email saved for that user)
# For Gmail, use an app password (with 2-Step Verification enabled), not your account password.
SMTP_EMAIL=your_smtp_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Receives "Request access" submissions (with the ready manage_users.py command).
ADMIN_EMAIL=
# Site address used in links inside outgoing email (never taken from request headers).
PUBLIC_URL=https://verquoai.com

# Live market data for view-only accounts that have not connected their own
# Zerodha account: the Zerodha ID whose Kite session serves it (quotes, candles
# and live prices only - never that account's orders, positions or profile).
# Works on days that account is logged in; otherwise viewers see the demo
# market. Leave empty to turn off. Check your Kite Connect / exchange data
# terms before showing live data to other people.
MARKET_DATA_ACCOUNT=

# Public "Try the demo" sessions (simulated market and broker, no account).
# At most this many run at once; each ends after this many idle minutes.
DEMO_MAX_SESSIONS=10
DEMO_IDLE_MINUTES=30
